#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                &kp N1          &kp N2  &kp N3  &kp N4
                &kp N5          &kp N6  &kp N7  &kp N8
                &studio_unlock  &kp N0  &bt BT_CLR &bt BT_NXT
            >;
        };
    };
};
