/*
 * Copyright (c) 2026 The ZMK Contributors
 * SPDX-License-Identifier: MIT
 *
 * macro_keyboard keymap
 *
 *   Physical layout: 3 rows x 4 cols + 1 profile button (13 keys total).
 *   Each layer represents one profile. There are 5 profiles by default,
 *   all blank: the only pre-bound keys are the profile button (pos 12,
 *   `&profile_next`) and the encoder-mode key (pos 3, `&enc_mode_next`,
 *   physically directly under the profile button). Everything else is
 *   `&none` — assign macros in ZMK Studio. `&profile_next` advances to the
 *   next profile based on the current highest-active layer and now wraps on
 *   the live layer count (so it tracks however many profiles exist).
 *
 *   Profiles 6 and 7 are `status = "reserved"` — spare slots so ZMK Studio's
 *   "add layer" can grow the profile count past the default 5 (up to 7, the
 *   most the status screen can show). They count toward ZMK_KEYMAP_LAYERS_LEN
 *   only in the Studio build (reordering on) and start inactive; the dev build
 *   (no reordering) ignores them entirely, so it stays at 5. They carry the
 *   same pre-bound keys + sensor binding as the others, so an added profile is
 *   functional immediately and can be renamed/edited in Studio.
 *
 *   `&profile_next` is implemented in zmk-config/module/src/behavior_profile_next.c
 *   and declared as a DT node below.
 *
 *   `&studio_unlock` is kept on profile 1 (pos 8) so ZMK Studio can be
 *   unlocked to edit — without it bound to a key Studio cannot be unlocked.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        profile_next: profile_next {
            compatible = "zmk,behavior-profile-next";
            #binding-cells = <0>;
        };

        /*
         * Encoder (AS5600) mode switching — see module/src/encoder_mode.c.
         * &enc_dispatch is each layer's sensor-binding; it acts on the active
         * profile's current mode. &enc_mode_next is a key that cycles that
         * profile's mode (volume -> vertical scroll -> horizontal scroll).
         */
        enc_mode_next: enc_mode_next {
            compatible = "zmk,behavior-encoder-mode-next";
            #binding-cells = <0>;
        };

        enc_dispatch: enc_dispatch {
            compatible = "zmk,behavior-encoder-dispatch";
            #sensor-binding-cells = <0>;

            /* No firmware scroll acceleration — the host smooth-scroll app
             * (Mac Mouse Fix) owns smoothing + acceleration. The firmware emits
             * a clean linear stream; the app shapes the feel.
             *   scroll-triggers-per-rotation = SCROLL SPEED knob (lines/rev).
             *                                  Lower = slower. The app smooths
             *                                  between ticks so it stays smooth.
             *   scroll-units                 = lines per tick (keep 1)
             *   scroll-max-value             = safety clamp
             *   volume-/tab-triggers-per-rotation = coarse step size for the
             *                                  discrete modes (one notch per
             *                                  volume step / browser tab). */
            volume-triggers-per-rotation = <14>;
            tab-triggers-per-rotation = <12>;
            scroll-triggers-per-rotation = <120>;
            scroll-units = <1>;
            scroll-max-value = <1000>;
            /* Coalesce scroll reports to <=~83/s. Sustained ~200/s per-tick
             * reports over USB wedge the HID TX path and hang the board; this
             * caps the rate without losing rotation (remainder carried). */
            scroll-min-interval-ms = <12>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * 5 blank profiles. Only the encoder-mode key (pos 3, directly under
         * the profile button) and the profile button (pos 12) are pre-bound;
         * everything else is &none, to be assigned in ZMK Studio. Profile 1
         * additionally keeps &studio_unlock (pos 8) so Studio can be unlocked.
         */
        profile_1 {
            display-name = "P1";
            bindings = <
                &none            &none             &none            &enc_mode_next
                &none            &none             &none            &none
                &studio_unlock   &none             &none            &none
                &profile_next
            >;
            sensor-bindings = <&enc_dispatch>;
        };

        profile_2 {
            display-name = "P2";
            bindings = <
                &none            &none             &none            &enc_mode_next
                &none            &none             &none            &none
                &none            &none             &none            &none
                &profile_next
            >;
            sensor-bindings = <&enc_dispatch>;
        };

        profile_3 {
            display-name = "P3";
            bindings = <
                &none            &none             &none            &enc_mode_next
                &none            &none             &none            &none
                &none            &none             &none            &none
                &profile_next
            >;
            sensor-bindings = <&enc_dispatch>;
        };

        profile_4 {
            display-name = "P4";
            bindings = <
                &none            &none             &none            &enc_mode_next
                &none            &none             &none            &none
                &none            &none             &none            &none
                &profile_next
            >;
            sensor-bindings = <&enc_dispatch>;
        };

        profile_5 {
            display-name = "P5";
            bindings = <
                &none            &none             &none            &enc_mode_next
                &none            &none             &none            &none
                &none            &none             &none            &none
                &profile_next
            >;
            sensor-bindings = <&enc_dispatch>;
        };

        /* Reserved spare slots for Studio "add layer" (max 7 profiles). */
        profile_6 {
            status = "reserved";
            display-name = "P6";
            bindings = <
                &none            &none             &none            &enc_mode_next
                &none            &none             &none            &none
                &none            &none             &none            &none
                &profile_next
            >;
            sensor-bindings = <&enc_dispatch>;
        };

        profile_7 {
            status = "reserved";
            display-name = "P7";
            bindings = <
                &none            &none             &none            &enc_mode_next
                &none            &none             &none            &none
                &none            &none             &none            &none
                &profile_next
            >;
            sensor-bindings = <&enc_dispatch>;
        };
    };
};
