#define PROFILE_1 0
#define PROFILE_2 1
#define PROFILE_3 2
#define PROFILE_4 3

#include <physical_layouts.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    chosen {
        zmk,physical-layout = &macro_keyboard_layout;
    };

    behaviors {
        rot_msc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
        };
    };

    macros {
        mc_copy: mc_copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(C)>;
        };

        mc_paste: mc_paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(V)>;
        };

        mc_cut: mc_cut {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(X)>;
        };
    };

    macro_keyboard_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <4>;
        columns = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3)
            RC(3,0)
        >;
    };

    macro_keyboard_layout: macro_keyboard_layout {
        compatible = "zmk,physical-layout";
        display-name = "Macro Keyboard";
        transform = <&macro_keyboard_transform>;
        keys
            = <&key_physical_attrs 100 100   0   0 0 0 0>
            , <&key_physical_attrs 100 100 100   0 0 0 0>
            , <&key_physical_attrs 100 100 200   0 0 0 0>
            , <&key_physical_attrs 100 100 300   0 0 0 0>
            , <&key_physical_attrs 100 100   0 100 0 0 0>
            , <&key_physical_attrs 100 100 100 100 0 0 0>
            , <&key_physical_attrs 100 100 200 100 0 0 0>
            , <&key_physical_attrs 100 100 300 100 0 0 0>
            , <&key_physical_attrs 100 100   0 200 0 0 0>
            , <&key_physical_attrs 100 100 100 200 0 0 0>
            , <&key_physical_attrs 100 100 200 200 0 0 0>
            , <&key_physical_attrs 100 100 300 200 0 0 0>
            , <&key_physical_attrs  60  60 420   0 0 0 0>
            ;
    };

    keymap {
        compatible = "zmk,keymap";

        profile_1 {
            display-name = "Profile 1";
            bindings = <
                &kp C_PP      &kp C_PREV    &kp C_NEXT    &kp C_MUTE
                &kp C_VOL_UP  &kp C_VOL_DN  &mc_copy      &mc_paste
                &mc_cut       &kp F13       &kp F14       &studio_unlock
                &to PROFILE_2
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        profile_2 {
            display-name = "Profile 2";
            bindings = <
                &kp HOME   &kp UP     &kp END    &kp PG_UP
                &kp LEFT   &kp DOWN   &kp RIGHT  &kp PG_DN
                &kp TAB    &kp ESC    &kp RET    &kp BSPC
                &to PROFILE_3
            >;
            sensor-bindings = <&rot_msc SCRL_DOWN SCRL_UP>;
        };

        profile_3 {
            display-name = "Profile 3";
            bindings = <
                &kp C_PREV  &kp C_PP   &kp C_NEXT  &kp C_MUTE
                &kp LG(LEFT) &kp LG(UP) &kp LG(DOWN) &kp LG(RIGHT)
                &kp INS     &kp DEL    &kp PSCRN   &kp PAUSE_BREAK
                &to PROFILE_4
            >;
            sensor-bindings = <&rot_msc SCRL_LEFT SCRL_RIGHT>;
        };

        profile_4 {
            display-name = "Profile 4";
            bindings = <
                &kp N1   &kp N2   &kp N3   &kp N4
                &kp N5   &kp N6   &kp N7   &kp N8
                &kp N9   &kp N0   &kp MINUS &kp EQUAL
                &to PROFILE_1
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
