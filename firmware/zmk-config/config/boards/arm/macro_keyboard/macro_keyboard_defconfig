# Enable MPU
CONFIG_ARM_MPU=y

# Use pinctrl
CONFIG_PINCTRL=y

# GPIO + ADC
CONFIG_GPIO=y
CONFIG_ADC=y

# Enable writing to flash
# Note: CONFIG_USE_DT_CODE_PARTITION is intentionally NOT set.
# Firmware is flashed directly via SWD (pyocd/DAPLink) — code must link from 0x0.
# Using USE_DT_CODE_PARTITION would link from 0x26000 (UF2-bootloader offset) and
# the chip would hang on reset with no valid vector table at 0x0.
CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

# 32kHz crystal
CONFIG_CLOCK_CONTROL_NRF_K32SRC_XTAL=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_150PPM=y

# ZMK transports
CONFIG_ZMK_BLE=y
CONFIG_ZMK_USB=y

# HID
CONFIG_ZMK_HID_REPORT_TYPE_NKRO=y
CONFIG_ZMK_HID_CONSUMER_REPORT_USAGES_BASIC=y
