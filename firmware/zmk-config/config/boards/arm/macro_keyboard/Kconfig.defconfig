if BOARD_MACRO_KEYBOARD

config BOARD
    default "macro_keyboard"

config ZMK_KEYBOARD_NAME
    default "macro_keyboard"

config BT_CTLR
    default BT

if USB

config USB_NRFX
    default y

config USB_DEVICE_STACK
    default y

endif # USB

# Match the panel's pixel format and isolate display rendering from BLE/USB.
# Same pattern used by ZMK's 128x64 SSD1306 shields (waterfowl, zodiark, kyria).
if ZMK_DISPLAY

# Display work runs on its own thread instead of the system work queue. Without
# this, any stall inside an LVGL flush — over a shared I2C bus, this happens —
# blocks the system work queue, and ZMK's BLE advertising + USB-HID TX run on
# that same queue, so the device fails to enumerate.
choice ZMK_DISPLAY_WORK_QUEUE
    default ZMK_DISPLAY_WORK_QUEUE_DEDICATED
endchoice

endif # ZMK_DISPLAY

if LVGL

# Match the SSD1306 monochrome panel. Default (RGB565 / 32bpp) produces noise
# on a 1bpp display and is far too large for our LV mem pool.
config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

# Larger draw buffer = fewer partial-render flushes per frame and fewer I2C
# transactions per frame. 10% (the Zephyr default) trickles flushes faster
# than the I2C bus can serve them, starving the display work queue.
config LV_Z_VDB_SIZE
    default 64

# LVGL object/style/theme pool. ZMK's app/src/display/Kconfig sets this to
# 4096 only when STATUS_SCREEN_BUILT_IN is selected — with CUSTOM it falls
# back to Zephyr's 2048 default, which is too small for theme_mono + screen
# + one label. lv_obj_create / lv_label_create then return NULL and the
# next call hardfaults, taking BLE/USB down with it. Our custom screen
# has 5 labels + 2 styles with bg/color/padding properties, which exceeds
# 4096 too. 8192 covered the M4 layout; the battery-icon rework adds the
# body/nub/fill objects + a charge-bolt canvas, so bumped to 12288 with
# measured headroom. (~4 KB extra RAM, well within the nRF52840 budget.)
config LV_Z_MEM_POOL_SIZE
    default 12288

# The battery row and profile digits are drawn pixel-crisp for the 1bpp
# panel using UNSCII (true 1bpp bitmap fonts, no anti-aliasing) instead of
# the 4bpp Montserrat, which thresholds to bulky/fuzzy glyphs on a mono
# display — and, for the profile digits, renders ~1 px thinner when the cell
# inverts in its CHECKED state. UNSCII 8 = battery %, UNSCII 16 = profile
# digits. The charge bolt is a small I1 lv_canvas, so LV_USE_CANVAS is on.
config LV_FONT_UNSCII_8
    default y

config LV_FONT_UNSCII_16
    default y

config LV_USE_CANVAS
    default y

# The BUILT_IN ZMK status screen implies these. The CUSTOM screen does not,
# but without them: theme_mono never initialises, no default font is set on
# the display, lv_label_create renders with a NULL font and faults — which
# brings BLE/USB down with it. Pin here so any screen choice (BUILT_IN or
# CUSTOM) gets a usable theme + font.
config LV_USE_THEME_MONO
    default y

config LV_FONT_MONTSERRAT_16
    default y

choice LV_FONT_DEFAULT
    default LV_FONT_DEFAULT_MONTSERRAT_16
endchoice

endif # LVGL

endif # BOARD_MACRO_KEYBOARD
