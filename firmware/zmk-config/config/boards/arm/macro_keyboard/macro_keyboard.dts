/dts-v1/;

#include <nordic/nrf52840_qiaa.dtsi>
/* No UF2/Adafruit bootloader — firmware is flashed directly via SWD (pyocd) */
#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    model = "macro_keyboard";
    compatible = "nikolas,macro-keyboard";

    chosen {
        zephyr,code-partition = &code_partition;
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
        zmk,battery = &vbatt;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "row2col";

        row-gpios
            = <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

        col-gpios
            = <&gpio0 16 GPIO_ACTIVE_HIGH>
            , <&gpio0 14 GPIO_ACTIVE_HIGH>
            , <&gpio0 15 GPIO_ACTIVE_HIGH>
            , <&gpio0 13 GPIO_ACTIVE_HIGH>
            ;
    };

    matrix_transform0: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <4>;
        rows = <3>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3)
        >;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "3x4 Default";
        transform = <&matrix_transform0>;
        kscan = <&kscan0>;

        keys  //                     w   h    x    y   rot  rx  ry
            = <&key_physical_attrs 100 100    0    0     0   0   0>
            , <&key_physical_attrs 100 100  100    0     0   0   0>
            , <&key_physical_attrs 100 100  200    0     0   0   0>
            , <&key_physical_attrs 100 100  300    0     0   0   0>
            , <&key_physical_attrs 100 100    0  100     0   0   0>
            , <&key_physical_attrs 100 100  100  100     0   0   0>
            , <&key_physical_attrs 100 100  200  100     0   0   0>
            , <&key_physical_attrs 100 100  300  100     0   0   0>
            , <&key_physical_attrs 100 100    0  200     0   0   0>
            , <&key_physical_attrs 100 100  100  200     0   0   0>
            , <&key_physical_attrs 100 100  200  200     0   0   0>
            , <&key_physical_attrs 100 100  300  200     0   0   0>
            ;
    };

    buttons {
        compatible = "gpio-keys";
        profile_btn: profile_btn {
            label = "Profile Switch";
            gpios = <&gpio1 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        };
    };

    vbatt: vbatt {
        compatible = "zmk,battery-voltage-divider";
        io-channels = <&adc 2>; /* AIN2 = P0.04 */
        output-ohms = <2000000>;
        full-ohms = <(2000000 + 820000)>;
    };
};

&reg1 {
    regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&adc {
    status = "okay";
};

&gpiote {
    status = "okay";
};

&gpio0 {
    status = "okay";
};

&gpio1 {
    status = "okay";
};

&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 24)>,
                    <NRF_PSEL(TWIM_SCL, 0, 25)>;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 24)>,
                    <NRF_PSEL(TWIM_SCL, 0, 25)>;
            low-power-enable;
        };
    };
};

&i2c0 {
    compatible = "nordic,nrf-twi";
    status = "okay";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_FAST>;

    oled: ssd1306@3c {
        status = "disabled";
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <64>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        segment-remap;
        com-invdir;
        prechargep = <0x22>;
    };
};

zephyr_udc0: &usbd {
    status = "okay";
};

&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        /* Code starts at 0x0 — flashed directly via SWD, no bootloader. */
        code_partition: partition@0 {
            reg = <0x00000000 0x000f0000>;
        };
        /* NVS settings storage at end of flash (64 KB) */
        storage_partition: partition@f0000 {
            reg = <0x000f0000 0x00010000>;
        };
    };
};
