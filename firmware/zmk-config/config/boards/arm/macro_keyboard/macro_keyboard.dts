/dts-v1/;

#include <nordic/nrf52840_qiaa.dtsi>
/* No UF2/Adafruit bootloader — firmware is flashed directly via SWD (pyocd) */
#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    model = "macro_keyboard";
    compatible = "nikolas,macro-keyboard";

    chosen {
        zephyr,code-partition = &code_partition;
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zmk,kscan = &kscan_composite;
        zmk,physical-layout = &physical_layout0;
        zmk,battery = &vbatt;
        zephyr,display = &oled;
    };

    kscan_matrix: kscan_matrix {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        row-gpios
            = <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

        col-gpios
            = <&gpio0 16 GPIO_ACTIVE_HIGH>
            , <&gpio0 14 GPIO_ACTIVE_HIGH>
            , <&gpio0 15 GPIO_ACTIVE_HIGH>
            , <&gpio0 13 GPIO_ACTIVE_HIGH>
            ;
    };

    /*
     * Profile-switch button driven as a single direct-GPIO kscan input so it
     * can bind to a ZMK behavior (layer-cycle) instead of being a passive
     * gpio-keys input.
     */
    kscan_direct: kscan_direct {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios = <&gpio1 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    /* Composite combines the 12-key matrix with the 1-key profile button. */
    kscan_composite: kscan_composite {
        compatible = "zmk,kscan-composite";
        rows = <4>;
        columns = <4>;

        matrix {
            kscan = <&kscan_matrix>;
        };

        profile {
            kscan = <&kscan_direct>;
            row-offset = <3>;
        };
    };

    matrix_transform0: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <4>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3)
            RC(3,0)
        >;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "3x4 + Profile";
        transform = <&matrix_transform0>;
        kscan = <&kscan_composite>;

        /*
         * Hardware places the profile button physically *above* the top-right
         * matrix key. We mirror that in the layout so ZMK Studio renders it
         * in the same spot the user is pressing.
         *
         *      +-----+
         *      | PRF |     <- pos 12 (profile button), at y=0
         *      +-----+
         *  +---+---+---+---+
         *  |0|1|2|3|         <- matrix row 0 lives at y=100
         *  +---+---+---+---+
         *  |4|5|6|7|
         *  +---+---+---+---+
         *  |8|9|10|11|
         *  +---+---+---+---+
         */
        keys  //                     w   h    x    y   rot  rx  ry
            = <&key_physical_attrs 100 100    0  100     0   0   0>
            , <&key_physical_attrs 100 100  100  100     0   0   0>
            , <&key_physical_attrs 100 100  200  100     0   0   0>
            , <&key_physical_attrs 100 100  300  100     0   0   0>
            , <&key_physical_attrs 100 100    0  200     0   0   0>
            , <&key_physical_attrs 100 100  100  200     0   0   0>
            , <&key_physical_attrs 100 100  200  200     0   0   0>
            , <&key_physical_attrs 100 100  300  200     0   0   0>
            , <&key_physical_attrs 100 100    0  300     0   0   0>
            , <&key_physical_attrs 100 100  100  300     0   0   0>
            , <&key_physical_attrs 100 100  200  300     0   0   0>
            , <&key_physical_attrs 100 100  300  300     0   0   0>
            , <&key_physical_attrs 100 100  300    0     0   0   0>
            ;
    };

    vbatt: vbatt {
        compatible = "zmk,battery-voltage-divider";
        io-channels = <&adc 2>; /* AIN2 = P0.04 */
        output-ohms = <1000000>;
        full-ohms = <(1000000 + 330000)>;
    };
};

&reg1 {
    regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&adc {
    status = "okay";
};

&gpiote {
    status = "okay";
};

&gpio0 {
    status = "okay";
};

&gpio1 {
    status = "okay";
};

&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 24)>,
                    <NRF_PSEL(TWIM_SCL, 0, 25)>;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 24)>,
                    <NRF_PSEL(TWIM_SCL, 0, 25)>;
            low-power-enable;
        };
    };
};

&i2c0 {
    compatible = "nordic,nrf-twi";
    status = "okay";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_FAST>;

    oled: ssd1306@3c {
        status = "okay";
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <64>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        segment-remap;
        com-invdir;
        prechargep = <0x22>;
    };
};

zephyr_udc0: &usbd {
    status = "okay";
};

&flash0 {
    /*
     * Flash layout for the Adafruit nRF52 UF2 bootloader (no SoftDevice).
     * The bootloader itself lives at 0x000F4000–0x00100000 and is installed
     * once via SWD; the application links at 0x00026000.
     *
     *   0x000000 – 0x025FFF  reserved by bootloader (MBR + bootloader header)
     *   0x026000 – 0x0EBFFF  code_partition     (~792 KB ZMK app)
     *   0x0EC000 – 0x0F3FFF  storage_partition   (32 KB NVS)
     *   0x0F4000 – 0x0FFFFF  reserved for bootloader code
     *
     * If the bootloader is ever removed (full chip-erase + direct-SWD only)
     * this layout must be reverted; see [BOOTLOADER WORKFLOW] in CLAUDE.md.
     */
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        code_partition: partition@26000 {
            reg = <0x00026000 0x000C6000>;
        };
        storage_partition: partition@ec000 {
            reg = <0x000EC000 0x00008000>;
        };
    };
};
