# Entferne SOC und BOARD Konfigurationen für Zephyr 4.1
# Diese werden jetzt durch board.yml und Kconfig.macro_keyboard gehandhabt

# Enable MPU
CONFIG_ARM_MPU=y

# Enable hardware stack protection
CONFIG_HW_STACK_PROTECTION=y

# Enable RTT
CONFIG_USE_SEGGER_RTT=y

# Enable GPIO
CONFIG_GPIO=y

# Enable serial (USB CDC ACM used for console; nRF UART not in DT)
CONFIG_SERIAL=y

# ZMK Studio off by default (requires protoc: brew install protobuf)
CONFIG_ZMK_STUDIO=n