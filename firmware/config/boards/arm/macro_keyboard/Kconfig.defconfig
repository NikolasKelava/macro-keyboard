if BOARD_MACRO_KEYBOARD

config BOARD
    default "macro_keyboard"

config ZMK_KEYBOARD_NAME
    default "Macro Keyboard"

config BT_CTLR
    default BT

config ZMK_BLE
    default y

config ZMK_USB
    default y

if USB_DEVICE_STACK

config USB_NRFX
    default y

endif # USB_DEVICE_STACK

config ZMK_BATTERY_VOLTAGE_DIVIDER
    default y

# ZMK Studio (enable in .conf and install protobuf for configurator)
config ZMK_STUDIO
    default n

endif # BOARD_MACRO_KEYBOARD